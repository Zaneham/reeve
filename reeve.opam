# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "SLATEC and a few LAPACK routines in OCaml"
description:
  "A port of the SLATEC Common Mathematical Library, with a few LAPACK routines, into OCaml. It is written in OCaml throughout, so the only thing it depends on is the compiler. It is checked by running it and the reference Fortran over the same inputs and comparing the output in hex."
maintainer: ["Zane Hambly <zanehambly@gmail.com>"]
authors: ["Zane Hambly"]
license: "Apache-2.0"
homepage: "https://github.com/Zaneham/reeve"
bug-reports: "https://github.com/Zaneham/reeve/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Zaneham/reeve.git"
